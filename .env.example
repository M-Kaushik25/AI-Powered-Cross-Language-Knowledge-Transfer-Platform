# ==============================================================================
# CL-RAG Platform: Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# NEVER commit your actual .env file or private credentials to version control.
# ==============================================================================

# Server Environment (development | production | test)
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Security & Authentication (Required for Production, minimum 32 chars)
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_hex_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database Configuration (SQLite WAL mode)
# Leave blank to use default location: backend/data/platform.db
DATABASE_PATH=

# LLM Providers & Multi-Agent Architecture
# LLM_MODE options: 'live' (raises 502 on failure), 'offline' (deterministic demo), 'auto' (live with offline fallback)
LLM_MODE=auto
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Living Terminology KG Review Workflow
# Number of distinct human reviewers required to approve a term (N=2)
REVIEW_APPROVALS_REQUIRED=2

# Dense Multilingual Retrieval
# Supported: intfloat/multilingual-e5-base or BAAI/bge-m3
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Confidence Gating Threshold (tau)
CONFIDENCE_THRESHOLD=0.85
